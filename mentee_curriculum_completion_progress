-- Cohort-aware mentee curriculum completion (Redshift-compatible)
-- Grain: one row per (mentee_id, cycle), including empty mentee×cycle rows
-- Mentee spine: mentors.mentee_database (program IN EmONC curriculum / both),
-- plus any mentee_id only present in fact tables
-- Skill avg: AVG of per-skill MAX(average_score) within each mentee×cycle
-- date_completed = first date within the cycle when ALL conditions were met; else NULL
--
-- To add a future cohort: insert another UNION ALL SELECT in the cohorts CTE below.
-- Windows are inclusive on both ends: cycle_start <= date <= cycle_end.

WITH cohorts AS (
    SELECT
        CAST(1 AS INTEGER) AS cycle_id,
        CAST('Cohort 1' AS VARCHAR(50)) AS cycle_label,
        DATE '2024-01-01' AS cycle_start,
        DATE '2026-03-31' AS cycle_end,
        CAST(11 AS INTEGER) AS req_cme,
        CAST(5 AS INTEGER) AS req_drills,
        CAST(18 AS INTEGER) AS req_skill_demo,
        CAST(18 AS INTEGER) AS req_return_demo,
        CAST(1 AS INTEGER) AS req_labor_monitoring,
        CAST(18 AS INTEGER) AS req_skill_eval
    UNION ALL
    SELECT
        CAST(2 AS INTEGER),
        CAST('Cohort 2' AS VARCHAR(50)),
        DATE '2026-04-01',
        DATE '2027-03-31',
        CAST(13 AS INTEGER),
        CAST(5 AS INTEGER),
        CAST(21 AS INTEGER),
        CAST(21 AS INTEGER),
        CAST(1 AS INTEGER),
        CAST(21 AS INTEGER)
    UNION ALL
    SELECT
        CAST(3 AS INTEGER),
        CAST('Cohort 3' AS VARCHAR(50)),
        DATE '2027-04-01',
        DATE '2028-03-31',
        CAST(13 AS INTEGER),
        CAST(5 AS INTEGER),
        CAST(21 AS INTEGER),
        CAST(21 AS INTEGER),
        CAST(1 AS INTEGER),
        CAST(21 AS INTEGER)
),

-- Prefer mentors.mentee_database; still include fact-table mentees missing from it
db_mentees AS (
    SELECT
        CAST(mentee_id AS VARCHAR(100)) AS mentee_id,
        CAST(mentee_name AS VARCHAR(256)) AS mentee_name,
        CAST(county AS VARCHAR(256)) AS county,
        CAST(facility AS VARCHAR(256)) AS facility,
        CAST(facility_code AS VARCHAR(100)) AS facility_code
    FROM mentors.mentee_database
    WHERE LOWER(TRIM(program)) IN ('emonc curriculum', 'both')
),

fact_mentees AS (
    SELECT
        mentee_id,
        MAX(mentee_name) AS mentee_name,
        MAX(county) AS county,
        MAX(facility) AS facility,
        MAX(facility_code) AS facility_code
    FROM (
        SELECT
            CAST(mentee_id AS VARCHAR(100)) AS mentee_id,
            CAST(mentee_name AS VARCHAR(256)) AS mentee_name,
            CAST(county AS VARCHAR(256)) AS county,
            CAST(facility AS VARCHAR(256)) AS facility,
            CAST(facility_code AS VARCHAR(100)) AS facility_code
        FROM mentors.mentee_curriculum_tracking

        UNION ALL

        SELECT
            CAST(mentee_id AS VARCHAR(100)) AS mentee_id,
            CAST(mentee_name AS VARCHAR(256)) AS mentee_name,
            CAST(county AS VARCHAR(256)) AS county,
            CAST(facility AS VARCHAR(256)) AS facility,
            CAST(facility_code AS VARCHAR(100)) AS facility_code
        FROM mentors.process_moh_skills_assessment_2026
    ) u
    GROUP BY mentee_id
),

mentees AS (
    SELECT
        COALESCE(d.mentee_id, f.mentee_id) AS mentee_id,
        COALESCE(d.mentee_name, f.mentee_name) AS mentee_name,
        COALESCE(d.county, f.county) AS county,
        COALESCE(d.facility, f.facility) AS facility,
        COALESCE(d.facility_code, f.facility_code) AS facility_code
    FROM db_mentees d
    FULL OUTER JOIN fact_mentees f
        ON d.mentee_id = f.mentee_id
),

-- All mentee × cohort combinations (empty progress rows included)
mentee_cycles AS (
    SELECT
        m.mentee_id,
        m.mentee_name,
        m.county,
        m.facility,
        m.facility_code,
        c.cycle_id,
        c.cycle_label,
        c.cycle_start,
        c.cycle_end,
        c.req_cme,
        c.req_drills,
        c.req_skill_demo,
        c.req_return_demo,
        c.req_labor_monitoring,
        c.req_skill_eval
    FROM mentees m
    CROSS JOIN cohorts c
),

-- Curriculum tracking rows assigned to a cohort by submission date
tracking_by_cycle AS (
    SELECT
        c.cycle_id,
        c.req_cme,
        c.req_drills,
        c.req_skill_demo,
        c.req_return_demo,
        c.req_labor_monitoring,
        CAST(t.mentee_id AS VARCHAR(100)) AS mentee_id,
        t.mentorship_activity,
        t.topic,
        CAST(t.date_submitted AS DATE) AS date_submitted
    FROM mentors.mentee_curriculum_tracking t
    INNER JOIN cohorts c
        ON CAST(t.date_submitted AS DATE) >= c.cycle_start
       AND CAST(t.date_submitted AS DATE) <= c.cycle_end
    WHERE t.topic IS NOT NULL
),

-- First date each distinct topic was done in a cycle (standard activities)
topic_first AS (
    SELECT
        cycle_id,
        mentee_id,
        mentorship_activity,
        topic,
        MIN(date_submitted) AS first_date,
        MAX(req_cme) AS req_cme,
        MAX(req_drills) AS req_drills,
        MAX(req_skill_demo) AS req_skill_demo,
        MAX(req_return_demo) AS req_return_demo
    FROM tracking_by_cycle
    WHERE mentorship_activity IN (
        'cmes',
        'drills',
        'skill_demos_mentor',
        'skills_demos_mentee'
    )
    GROUP BY cycle_id, mentee_id, mentorship_activity, topic
),

topic_ranked AS (
    SELECT
        tf.*,
        ROW_NUMBER() OVER (
            PARTITION BY tf.cycle_id, tf.mentee_id, tf.mentorship_activity
            ORDER BY tf.first_date, tf.topic
        ) AS rn
    FROM topic_first tf
),

cme AS (
    SELECT
        cycle_id,
        mentee_id,
        COUNT(*) AS completed_topics,
        MAX(req_cme) AS required_topics,
        MIN(CASE WHEN rn = req_cme THEN first_date END) AS threshold_date
    FROM topic_ranked
    WHERE mentorship_activity = 'cmes'
    GROUP BY cycle_id, mentee_id
),

drills AS (
    SELECT
        cycle_id,
        mentee_id,
        COUNT(*) AS completed_topics,
        MAX(req_drills) AS required_topics,
        MIN(CASE WHEN rn = req_drills THEN first_date END) AS threshold_date
    FROM topic_ranked
    WHERE mentorship_activity = 'drills'
    GROUP BY cycle_id, mentee_id
),

skill_demo AS (
    SELECT
        cycle_id,
        mentee_id,
        COUNT(*) AS completed_topics,
        MAX(req_skill_demo) AS required_topics,
        MIN(CASE WHEN rn = req_skill_demo THEN first_date END) AS threshold_date
    FROM topic_ranked
    WHERE mentorship_activity = 'skill_demos_mentor'
    GROUP BY cycle_id, mentee_id
),

return_demo AS (
    SELECT
        cycle_id,
        mentee_id,
        COUNT(*) AS completed_topics,
        MAX(req_return_demo) AS required_topics,
        MIN(CASE WHEN rn = req_return_demo THEN first_date END) AS threshold_date
    FROM topic_ranked
    WHERE mentorship_activity = 'skills_demos_mentee'
    GROUP BY cycle_id, mentee_id
),

-- Labor monitoring: qualifying case-scenario topics; need req_labor_monitoring distinct topics
labor_topic_first AS (
    SELECT
        cycle_id,
        mentee_id,
        topic,
        MIN(date_submitted) AS first_date,
        MAX(req_labor_monitoring) AS req_labor_monitoring
    FROM tracking_by_cycle
    WHERE mentorship_activity IN (
            'video_case_scenarios',
            'videoa_case_scenarios',
            'case_scenarios'
        )
      AND topic IN (
            'Partograph_use_and_interpretation',
            'Labor Monitoring'
        )
    GROUP BY cycle_id, mentee_id, topic
),

labor_ranked AS (
    SELECT
        ltf.*,
        ROW_NUMBER() OVER (
            PARTITION BY ltf.cycle_id, ltf.mentee_id
            ORDER BY ltf.first_date, ltf.topic
        ) AS rn
    FROM labor_topic_first ltf
),

labor_monitoring AS (
    SELECT
        cycle_id,
        mentee_id,
        COUNT(*) AS completed_topics,
        MAX(req_labor_monitoring) AS required_topics,
        MIN(CASE WHEN rn = req_labor_monitoring THEN first_date END) AS threshold_date
    FROM labor_ranked
    GROUP BY cycle_id, mentee_id
),

-- Skill evaluations:
-- 1) highest score per skill, per mentee, per cycle
-- 2) avg_skill_score = average of those per-skill maxima
-- 3) a skill counts as complete only when its max score is >= 0.85
skill_eval_by_skill AS (
    SELECT
        c.cycle_id,
        c.req_skill_eval,
        CAST(s.mentee_id AS VARCHAR(100)) AS mentee_id,
        s.skill_evaluation,
        MAX(s.average_score) AS max_score,
        MIN(
            CASE
                WHEN s.average_score >= 0.85
                THEN CAST(s.date_submitted AS DATE)
            END
        ) AS first_pass_date
    FROM mentors.process_moh_skills_assessment_2026 s
    INNER JOIN cohorts c
        ON CAST(s.date_submitted AS DATE) >= c.cycle_start
       AND CAST(s.date_submitted AS DATE) <= c.cycle_end
    WHERE s.skill_evaluation IS NOT NULL
      AND s.average_score IS NOT NULL
    GROUP BY
        c.cycle_id,
        c.req_skill_eval,
        CAST(s.mentee_id AS VARCHAR(100)),
        s.skill_evaluation
),

skill_eval_passed AS (
    SELECT
        cycle_id,
        req_skill_eval,
        mentee_id,
        skill_evaluation,
        max_score,
        first_pass_date,
        ROW_NUMBER() OVER (
            PARTITION BY cycle_id, mentee_id
            ORDER BY first_pass_date, skill_evaluation
        ) AS rn
    FROM skill_eval_by_skill
    WHERE max_score >= 0.85
      AND first_pass_date IS NOT NULL
),

skill_eval_stats AS (
    SELECT
        cycle_id,
        mentee_id,
        SUM(CASE WHEN max_score >= 0.85 THEN 1 ELSE 0 END) AS completed_assessments,
        MAX(req_skill_eval) AS required_assessments,
        AVG(max_score) AS avg_skill_score
    FROM skill_eval_by_skill
    GROUP BY cycle_id, mentee_id
),

skill_eval_threshold AS (
    SELECT
        cycle_id,
        mentee_id,
        MIN(CASE WHEN rn = req_skill_eval THEN first_pass_date END) AS threshold_date
    FROM skill_eval_passed
    GROUP BY cycle_id, mentee_id
),

skill_evaluation AS (
    SELECT
        s.cycle_id,
        s.mentee_id,
        s.completed_assessments,
        s.required_assessments,
        s.avg_skill_score,
        t.threshold_date
    FROM skill_eval_stats s
    LEFT JOIN skill_eval_threshold t
        ON s.cycle_id = t.cycle_id
       AND s.mentee_id = t.mentee_id
),

progress AS (
    SELECT
        mc.mentee_id,
        mc.mentee_name,
        mc.county,
        mc.facility,
        mc.facility_code,
        mc.cycle_id,
        mc.cycle_label,
        mc.cycle_start,
        mc.cycle_end,

        ROUND(
            LEAST(
                CAST(COALESCE(cme.completed_topics, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_cme, 0),
                1
            ),
            3
        ) AS cme_completion,

        ROUND(
            LEAST(
                CAST(COALESCE(d.completed_topics, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_drills, 0),
                1
            ),
            3
        ) AS drill_completion,

        ROUND(
            LEAST(
                CAST(COALESCE(sd.completed_topics, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_skill_demo, 0),
                1
            ),
            3
        ) AS skill_demo_completion,

        ROUND(
            LEAST(
                CAST(COALESCE(rd.completed_topics, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_return_demo, 0),
                1
            ),
            3
        ) AS return_demo_completion,

        ROUND(
            LEAST(
                CAST(COALESCE(lm.completed_topics, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_labor_monitoring, 0),
                1
            ),
            3
        ) AS labor_monitoring_completion,

        ROUND(
            LEAST(
                CAST(COALESCE(se.completed_assessments, 0) AS DECIMAL(18, 6))
                / NULLIF(mc.req_skill_eval, 0),
                1
            ),
            3
        ) AS skill_evaluation_completion,

        ROUND(CAST(se.avg_skill_score AS DECIMAL(18, 6)), 3) AS avg_skill_score,

        cme.threshold_date AS cme_threshold_date,
        d.threshold_date AS drill_threshold_date,
        sd.threshold_date AS skill_demo_threshold_date,
        rd.threshold_date AS return_demo_threshold_date,
        lm.threshold_date AS labor_monitoring_threshold_date,
        se.threshold_date AS skill_evaluation_threshold_date
    FROM mentee_cycles mc
    LEFT JOIN cme
        ON mc.mentee_id = cme.mentee_id
       AND mc.cycle_id = cme.cycle_id
    LEFT JOIN drills d
        ON mc.mentee_id = d.mentee_id
       AND mc.cycle_id = d.cycle_id
    LEFT JOIN skill_demo sd
        ON mc.mentee_id = sd.mentee_id
       AND mc.cycle_id = sd.cycle_id
    LEFT JOIN return_demo rd
        ON mc.mentee_id = rd.mentee_id
       AND mc.cycle_id = rd.cycle_id
    LEFT JOIN labor_monitoring lm
        ON mc.mentee_id = lm.mentee_id
       AND mc.cycle_id = lm.cycle_id
    LEFT JOIN skill_evaluation se
        ON mc.mentee_id = se.mentee_id
       AND mc.cycle_id = se.cycle_id
)

SELECT
    mentee_id,
    mentee_name,
    county,
    facility,
    facility_code,
    cycle_id,
    cycle_label,
    cycle_start,
    cycle_end,
    cme_completion,
    drill_completion,
    skill_demo_completion,
    return_demo_completion,
    labor_monitoring_completion,
    skill_evaluation_completion,
    avg_skill_score,

    CASE
        WHEN cme_completion >= 1
         AND drill_completion >= 1
         AND skill_demo_completion >= 1
         AND return_demo_completion >= 1
         AND labor_monitoring_completion >= 1
         AND skill_evaluation_completion >= 1
        THEN 1
        ELSE 0
    END AS curriculum_completion,

    CASE
        WHEN cme_completion >= 1
         AND drill_completion >= 1
         AND skill_demo_completion >= 1
         AND return_demo_completion >= 1
         AND labor_monitoring_completion >= 1
         AND skill_evaluation_completion >= 1
         AND cme_threshold_date IS NOT NULL
         AND drill_threshold_date IS NOT NULL
         AND skill_demo_threshold_date IS NOT NULL
         AND return_demo_threshold_date IS NOT NULL
         AND labor_monitoring_threshold_date IS NOT NULL
         AND skill_evaluation_threshold_date IS NOT NULL
        THEN GREATEST(
            cme_threshold_date,
            drill_threshold_date,
            skill_demo_threshold_date,
            return_demo_threshold_date,
            labor_monitoring_threshold_date,
            skill_evaluation_threshold_date
        )
        ELSE NULL
    END AS date_completed

FROM progress
ORDER BY mentee_id, cycle_id;
