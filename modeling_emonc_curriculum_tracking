## 3. Staging

One cleaned submission row. Keep raw payload columns needed for intermediate parsing
(or keep a single `payload` JSON column if Airbyte stores it).

```sql
-- models/staging/airbyte/stg_airbyte__emonc_curriculum_tracking.sql
-- Staging: 1 row per Kobo submission. No mentee/activity explode yet.

{%- set src = source('airbyte', 'emonc_curriculum_tracking') -%}

with source as (

    select * from {{ src }}

),

renamed as (

    select
        -- Prefer _uuid for durable keys; fall back to numeric _id
        coalesce(
            nullIf(trim(toString({{ resolve_column(src, '_uuid') }})), ''),
            nullIf(trim(toString({{ resolve_column(src, '_id') }})), '')
        ) as submission_id,

        parseDateTime64BestEffortOrNull(
            toString({{ resolve_column(src, '_submission_time') }})
        ) as submitted_at,

        -- Pass through common flattened columns when present; intermediate
        -- still searches alternate schemas via payload / map columns.
        nullIf(trim(toString({{ resolve_column(src, 'demographic_information/mentor_details/session_date') }})), '')
            as session_date_raw,
        nullIf(trim(toString({{ resolve_column(src, 'demographic_information/mentor_details/mentor_name') }})), '')
            as mentor_name_raw,
        nullIf(trim(toString({{ resolve_column(src, 'demographic_information/facility_details/county') }})), '')
            as county_raw,
        nullIf(
            trim(toString({{ resolve_column(src, 'emonc_training_curriculum/emonc_curriculum_activities/emonc_activities') }})),
            ''
        ) as activities_raw,

        -- Full row for multi-schema field discovery in intermediate
        * except (
            -- list only if ClickHouse * EXCEPT needs explicit Airbyte meta cols
        )
    from source

)

select
    submission_id,
    submitted_at,
    session_date_raw,
    mentor_name_raw,
    county_raw,
    activities_raw,
    *
from renamed
where submission_id is not null
```

YAML contract:

```yaml
# models/staging/airbyte/_airbyte__models.yml  (add)
models:
  - name: stg_airbyte__emonc_curriculum_tracking
    description: Cleaned EmONC CTF submissions from Airbyte (one row per Kobo submission).
    columns:
      - name: submission_id
        data_tests: [not_null, unique]
      - name: submitted_at
        data_tests: [not_null]
```

