### 4.2 Explode to activity rows

ClickHouse-friendly approach when Airbyte lands **flattened** columns: use
`arrayJoin` on split activity / mentee / topic tokens. When the payload is JSON,
parse with `JSONExtract*` / `JSONExtractKeysAndValues` in a dedicated model.

Pseudo-SQL for the flattened path (illustrative — adjust column names after `DESCRIBE`):

```sql
-- models/intermediate/int_emonc_curriculum_activity_rows.sql
-- Grain: submission × mentee × activity × topic
-- Implements process_mentee_data() from the transformation framework.

with submissions as (

    select * from {{ ref('stg_airbyte__emonc_curriculum_tracking') }}

),

-- Normalize activity tokens; fix known typo videoa_case_scenarios
activities as (

    select
        s.submission_id,
        s.submitted_at,
        multiIf(
            lowerUTF8(activity_raw) = 'videoa_case_scenarios', 'video_case_scenarios',
            lowerUTF8(activity_raw)
        ) as mentorship_activity,
        activity_raw as mentorship_activity_raw
    from submissions s
    array join splitByWhitespace(coalesce(s.activities_raw, '')) as activity_raw
    where activity_raw != ''

),

-- Mentee tokens: "12345_jane_doe 67890_john_smith"
mentees as (

    select
        s.submission_id,
        nullIf(splitByChar('_', mentee_tok)[1], '') as mentee_id,
        initcapUTF8(
            replaceAll(
                arrayStringConcat(arraySlice(splitByChar('_', mentee_tok), 2), ' '),
                '_',
                ' '
            )
        ) as mentee_name
    from submissions s
    -- Resolve the first populated *_mentees column via a helper view or map
    array join splitByWhitespace(coalesce(s.mentees_raw, '')) as mentee_tok
    where mentee_tok != ''

),

-- Topics: only the field that belongs to mentorship_activity (framework pairing)
topics as (

    select
        a.submission_id,
        a.mentorship_activity,
        topic_tok as topic_code
    from activities a
    inner join submissions s on a.submission_id = s.submission_id
    array join splitByWhitespace(
        coalesce(
            multiIf(
                a.mentorship_activity = 'cmes', s.cmes_raw,
                a.mentorship_activity = 'videos', s.videos_raw,
                a.mentorship_activity = 'case_scenarios', s.case_scenarios_raw,
                a.mentorship_activity = 'video_case_scenarios', s.video_scenarios_raw,
                a.mentorship_activity = 'skill_demos_mentor', s.mentor_skills_demo_raw,
                a.mentorship_activity = 'skills_demos_mentee', s.mentee_skills_return_demo_raw,
                a.mentorship_activity = 'drills', s.drills_raw,
                ''
            ),
            ''
        )
    ) as topic_tok
    where topic_tok != ''

),

facility as (

    select
        submission_id,
        -- value pattern: "{code}_{facility_name_slug}"
        toInt64OrNull(splitByChar('_', facility_raw)[1]) as facility_code,
        initcapUTF8(
            replaceAll(
                arrayStringConcat(arraySlice(splitByChar('_', facility_raw), 2), ' '),
                '_',
                ' '
            )
        ) as facility
    from submissions
    where facility_raw != ''

),

joined as (

    select
        s.submission_id,
        s.submitted_at,
        toDateOrNull(s.session_date_raw) as session_date,
        -- Mentor: replace commas with "/", title-case segments
        arrayStringConcat(
            arrayMap(
                x -> initcapUTF8(trim(x)),
                splitByChar('/', replaceAll(coalesce(s.mentor_name_raw, ''), ',', '/'))
            ),
            '/'
        ) as mentor_name,
        initcapUTF8(replaceAll(coalesce(s.county_raw, ''), '_', ' ')) as county,
        f.facility_code,
        f.facility,
        m.mentee_id,
        m.mentee_name,
        a.mentorship_activity,
        t.topic_code,
        coalesce(map.topic_label, replaceAll(t.topic_code, '_', ' ')) as topic
    from submissions s
    inner join activities a on s.submission_id = a.submission_id
    inner join topics t
        on a.submission_id = t.submission_id
       and a.mentorship_activity = t.mentorship_activity
    left join mentees m on s.submission_id = m.submission_id
    left join facility f on s.submission_id = f.submission_id
    left join {{ ref('emonc_topic_label_map') }} map
        on t.topic_code = map.topic_raw

)

select *
from joined
-- Framework: skip activity rows with no topic
where topic_code is not null
```

### 4.3 Facility inattendance (side stream)

```sql
-- models/intermediate/int_emonc_facility_inattendance.sql
-- Grain: submission × reason (from process_facility_inattendance_reasons)

with submissions as (

    select * from {{ ref('stg_airbyte__emonc_curriculum_tracking') }}

),

reasons as (

    select
        submission_id,
        submitted_at,
        facility_code,
        reason_tok as facility_level_reasons_for_inattendance
    from submissions
    array join splitByWhitespace(coalesce(inattendance_reasons_raw, '')) as reason_tok
    where reason_tok != ''

)

select * from reasons
```

