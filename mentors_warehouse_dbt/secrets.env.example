# Local secrets for Mentors Warehouse dbt — DO NOT COMMIT real values.
# Copy to ~/.config/mentors_warehouse.env (or any path outside git) and fill in.
# Then:  source ~/.config/mentors_warehouse.env

# Required
export MENTORS_CLICKHOUSE_PASSWORD='REPLACE_ME_SECRET_PASSWORD'

# Recommended
export MENTORS_CLICKHOUSE_HOST='REPLACE_ME_CLICKHOUSE_HOST'
export MENTORS_CLICKHOUSE_USER='default'

# Optional prod
# export MENTORS_CLICKHOUSE_PASSWORD_PROD='REPLACE_ME_SECRET_PASSWORD_PROD'
# export MENTORS_CLICKHOUSE_HOST_PROD='REPLACE_ME_CLICKHOUSE_HOST_PROD'
# export MENTORS_CLICKHOUSE_USER_PROD='default'
